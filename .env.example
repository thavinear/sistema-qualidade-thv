# Copy these values into the backend process environment before starting Spring Boot.
# Spring Boot does not load this file automatically.
DATABASE_URL=jdbc:postgresql://localhost:5432/sgq
DB_USERNAME=sgq
DB_PASSWORD=replace-with-local-database-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_SECONDS=3600
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
FRONTEND_ORIGIN=http://localhost:5173
